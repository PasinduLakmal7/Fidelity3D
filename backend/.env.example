# Qwen Cloud API Keys
QWEN_API_KEY=your_qwen_api_key_here

# 3D Generation API (Hunyuan3D/Tripo3D or equivalent)
GEN3D_API_KEY=your_3d_generation_api_key_here
GEN3D_API_URL=https://api.example.com/v1/generate

# Database
DATABASE_URL=sqlite:///./fidelity3d.db

# Storage / Alibaba Cloud
ALIBABA_CLOUD_ACCESS_KEY_ID=your_alibaba_access_key
ALIBABA_CLOUD_ACCESS_KEY_SECRET=your_alibaba_secret
OSS_BUCKET_NAME=fidelity3d-assets
OSS_ENDPOINT=oss-cn-hangzhou.aliyuncs.com

# FastAPI settings
HOST=0.0.0.0
PORT=8000
DEBUG=True
